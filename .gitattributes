# ============================================================================
#  行尾与二进制规则（随仓库分发，保证任何机器上克隆结果一致）
# ============================================================================

# 默认由 git 自动判定文本/二进制，并对文本做行尾规范化
* text=auto

# ---- Windows 脚本必须保持 CRLF ----
# 若被转成 LF，cmd.exe 会逐行吞掉首个字符，导致 build.bat 完全无法执行
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---- 源码与文档：仓库内以 LF 存储 ----
*.cpp   text
*.h     text
*.rc    text
*.md    text

# ---- 配置文件自身保持 LF，避免被自动转换 ----
.gitattributes  text eol=lf
.gitignore      text eol=lf

# ---- 二进制资源：禁止任何转换与合并 ----
*.ico   binary
*.png   binary
*.exe   binary
*.res   binary
*.obj   binary
